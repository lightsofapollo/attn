            "status": 201
          }
        },
        {
          "action": "registerDevice",
          "in": "room",
          "as": "dev",
          "params": {
            "participantId": "carol"
          },
          "expect": {
            "status": 204
          }
        },
        {
          "action": "postEnvelopes",
          "in": "room",
          "from": "dev",
          "params": {
            "envelopes": [
              {
                "envelopeId": "too-old-1",
                "authorDevice": "dev"
              }
            ]
          },
          "expect": {
            "status": 201
          }
        },
        {
          "action": "bumpStorage",
          "in": "room",
          "key": "meta:oldest_retained_seq",
          "value": 5
        },
        {
          "action": "openSocket",
          "in": "room",
          "from": "dev",
          "as": "sock"
        },
        {
          "action": "sendFrame",
          "socket": "sock",
          "frame": {
            "type": "subscribe",
            "after": 2
          }
        },
        {
          "action": "expectFrame",
          "socket": "sock",
          "frame": {
            "type": "error",
            "code": "ATTN_CURSOR_TOO_OLD",
            "hasResyncFromSeq": true
          }
        },
        {
          "action": "expectClose",
          "socket": "sock",
          "code": 4005
        }
      ],
      "skip": true,
      "skipReason": "follow-up: scenario fixture needs timing/state adjustment (filed as attn-nnj.5.16)"
