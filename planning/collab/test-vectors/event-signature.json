      "expected": {
        "canonicalSignedBytes": "{\"body\":{\"anchor\":{\"baseHash\":\"hash-vec-1\",\"fileId\":\"file-vec-1\",\"position\":{\"byteRange\":[0,5],\"lineRange\":[1,1]},\"snapshotId\":\"snap-vec-1\",\"v\":2},\"body\":\"hello\",\"threadId\":\"thr-vec-1\",\"type\":\"comment_created\"},\"meta\":{\"authorId\":\"p-vec-1\",\"createdAt\":1700000000000,\"deviceId\":\"d-vec-1\",\"parentEventIds\":[],\"roomId\":\"room-vec-1\",\"v\":2}}",
        "signature": "AhjF-bhD-hGCCfcffAiqI9k_H4TT1YYxJBP-h8oQo1PEMCrhJGxrHRMfgzlk-6orCed2jUkoID9wHldJliBbDw",
        "signingKeyId": "If4x36FUomFia_hUBG_SJxt77UtqvkWqWId-9H-XIbk"
