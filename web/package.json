{
  "name": "attn-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-vscode-icon-map.mjs --default-pack=eyecons",
    "dev": "npm run generate:icons && vite",
    "dev:browser": "npm run generate:icons && vite --config vite.browser.config.ts",
    "dev:browser:shares": "npm run generate:icons && ATTN_DEV_RELAY_TARGET=http://localhost:8787 VITE_ATTN_RELAY_URL=http://localhost:5173 vite --config vite.browser.config.ts --port 5173 --strictPort",
    "build": "npm run generate:icons && npm run build:doc-runtime && vite build",
    "build:browser": "npm run generate:icons && npm run build:doc-runtime && vite build --config vite.browser.config.ts && npm run build:sw",
    "build:anchor-wasm": "node scripts/build-anchor-wasm.mjs",
    "check:anchor-wasm": "node scripts/build-anchor-wasm.mjs --check",
    "build:doc-runtime": "node scripts/build-doc-runtime.mjs",
    "check:doc-runtime": "node scripts/build-doc-runtime.mjs --check",
    "deploy:staging": "node scripts/deploy-browser-staging.mjs",
    "check": "npm run generate:icons && svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs",
    "test:e2e:hosted": "playwright test e2e/hosted-review.spec.ts",
    "test:e2e:html-annotation": "npm run build:doc-runtime && playwright test e2e/html-annotation-runtime.spec.ts",
    "check:route-bundles": "node scripts/check-route-bundles.mjs && node scripts/check-icon-bundles.mjs",
    "test:e2e:routes": "npm run build:browser && npm run check:route-bundles && playwright test --config playwright.routes.config.ts",
    "test:e2e:storage": "playwright test --config playwright.storage.config.ts",
    "test:e2e:push": "playwright test --config playwright.push.config.ts",
    "test:share-owner:live": "tsx scripts/test-browser-share-owner-live.ts",
    "build:sw": "vite build --config vite.sw.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@handlewithcare/prosemirror-suggest-changes": "^0.1.8",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@panzoom/panzoom": "^4.6.1",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "katex": "^0.16.33",
    "mermaid": "^11.12.3",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-highlight": "^0.15.0",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-search": "^1.1.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.41.6",
    "shiki": "^4.0.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@internationalized/date": "^3.11.0",
    "@lucide/svelte": "^0.561.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/diff": "^7.0.2",
    "@types/ws": "^8.18.1",
    "agentation-svelte": "^1.0.0",
    "bits-ui": "^2.16.2",
    "catppuccin-vsc-icons": "github:catppuccin/vscode-icons",
    "clsx": "^2.1.1",
    "eyecons": "github:azat-io/eyecons",
    "fake-indexeddb": "^6.2.5",
    "material-icon-theme": "^5.31.0",
    "mode-watcher": "^1.1.0",
    "seti-file-icons": "^0.0.8",
    "svelte-check": "^4.0.0",
    "svelte-sonner": "^1.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vscode-icons": "github:vscode-icons/vscode-icons#664b3de61a984888ee748de5b44897019b26ad3e",
    "wrangler": "^4.110.0",
    "ws": "^8.20.1"
  }
}
