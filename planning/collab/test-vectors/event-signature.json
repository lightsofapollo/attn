{
  "_schema": {
    "spec": "planning/collab/crypto-spec.md#signatures",
    "purpose": "Pin Ed25519 signing of canonical JSON over (eventMeta-WITHOUT-eventId || eventBody). `auth` is NEVER part of signed bytes. `eventId` is OMITTED before signing (chicken/egg: EventId is itself derived from these bytes — see attn-nnj.1.8).",
    "format": {
      "version": "Integer corpus version.",
      "vectors[].name": "Human label.",
      "vectors[].signingKey.private": "base64url-no-pad of the 32-byte Ed25519 seed (NOT the 64-byte expanded secret key).",
      "vectors[].signingKey.public": "base64url-no-pad of the 32-byte Ed25519 public key derived from `private`.",
      "vectors[].event.meta": "Object: { v, eventId, roomId, authorId, deviceId, createdAt:int-ms, parentEventIds:[...], snapshotId? (omit if absent) }. NOTE: `eventId` is present here because this is the on-the-wire shape; the signer strips it before canonicalizing.",
      "vectors[].event.body": "Object: ReviewEventBody. Tagged by `type`; field shape is event-kind-specific.",
      "vectors[].expected.canonicalSignedBytes": "UTF-8 string: canonicalJSON({meta: <meta WITHOUT eventId, parentEventIds sorted ASCII-ascending>, body}). Useful to debug divergence before the signature step.",
      "vectors[].expected.signature": "base64url-no-pad of the 64-byte Ed25519 signature.",
      "vectors[].expected.signingKeyId": "base64url-no-pad of SHA-256(publicSigningKey). Lives in `auth.signingKeyId`."
    },
    "filledBy": "attn-nnj.1.6 (Ed25519 sign/verify wrapper)",
    "determinism": "Ed25519 (RFC 8032) is deterministic — a given (seed, signedBytes) yields exactly one signature byte-for-byte. Cross-impl test means: TS/WASM impls must produce identical `signature` strings."
  },
  "version": 1,
  "vectors": [
    {
