{
  "_schema": {
    "spec": "planning/collab/crypto-spec.md#eventid",
    "purpose": "Pin EventId derivation: base64url(SHA-256(canonicalJSON({meta-without-eventId, body}))).",
    "format": {
      "version": "Integer corpus version.",
      "vectors[].name": "Human label.",
      "vectors[].event.meta": "Object WITHOUT `eventId` (the ID is computed FROM these bytes). Field shape matches the Rust `EventMeta` serde camelCase form minus `eventId`.",
      "vectors[].event.body": "ReviewEventBody, tagged by `type` per the Rust serde derive.",
      "vectors[].expected.canonicalBytes": "UTF-8 string fed into SHA-256 (object keys sorted ASCII-asc, absent fields omitted, parentEventIds pre-sorted).",
      "vectors[].expected.eventId": "base64url-no-pad of the full 32-byte SHA-256 digest (per spec, EventId uses the full digest, unlike EnvelopeId which truncates to 16 bytes)."
    },
    "rules": [
      "`parentEventIds` MUST be sorted ASCII-ascending before hashing (the corpus stores the post-sort order so the bytes are self-evident).",
      "`snapshotId` is OMITTED entirely if absent (never serialized as null).",
      "`meta.eventId` is NOT included in the bytes that produce eventId; it is added to meta AFTER computation for transmission.",
      "Vectors use fixed `roomSecret = 0x11 * 32`, deriving `roomId=hjCfgOvsatNOUedgxhZpyw` so cross-impl runs are reproducible without reimplementing the KDF."
    ],
    "filledBy": "attn-nnj.1.8 (ID helpers)"
  },
  "version": 1,
