        "public": "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo"
      },
      "event": {
        "meta": {
          "v": 2,
          "eventId": "placeholder-event-id-1",
          "roomId": "room-vec-1",
          "authorId": "p-vec-1",
          "deviceId": "d-vec-1",
          "createdAt": 1700000000000,
          "parentEventIds": []
        },
        "body": {
          "type": "comment_created",
          "threadId": "thr-vec-1",
          "anchor": {
            "v": 2,
            "fileId": "file-vec-1",
            "snapshotId": "snap-vec-1",
            "baseHash": "hash-vec-1",
