{
  "$schema": "./schema.md",
  "version": 1,
  "description": "Cross-language conformance corpus for the attn relay. See README.md for the format reference. Each scenario is a list of steps that BOTH the Miniflare replay runner (replay.test.ts) and the Rust transport tests (attn-nnj.6.7) execute end-to-end. Steps describe actions semantically (createRoom, registerDevice, etc.); crypto material (HMAC, Ed25519, PoW) is materialized at replay time from deterministic seeds so the same JSON works across runtimes.",
  "scenarios": [
    {
      "id": "lifecycle-001",
      "name": "Room lifecycle \u2014 create, register, post, subscribe, ack, delete",
      "spec": "relay-spec.md \u00a7Test Plan #1",
      "tags": [
        "lifecycle",
        "happy-path"
      ],
      "steps": [
        {
          "action": "createRoom",
          "as": "room",
          "params": {
            "policy": {
              "deleteEventsAfterOwnerAck": true
            }
          },
          "expect": {
            "status": 201,
            "bodyShape": {
              "serverSeq": 0,
              "policyDeleteEventsAfterOwnerAck": true
            }
          }
        },
        {
          "action": "registerDevice",
          "in": "room",
          "as": "owner",
          "params": {
            "participantId": "owner-participant",
            "kind": "owner",
            "useOwnerKeypair": true
          },
          "expect": {
            "status": 204
          }
        },
        {
          "action": "registerDevice",
          "in": "room",
          "as": "reviewer",
          "params": {
            "participantId": "reviewer-participant",
            "kind": "reviewer"
          },
          "expect": {
            "status": 204
          }
        },
        {
          "action": "listDevices",
          "in": "room",
          "expect": {
            "status": 200,
            "bodyShape": {
              "devicesLength": 2,
              "deviceIdsInOrder": [
                "owner",
                "reviewer"
              ]
            }
          }
        },
        {
          "action": "postEnvelopes",
          "in": "room",
          "from": "reviewer",
          "params": {
            "envelopes": [
              {
                "envelopeId": "env-lc-1",
                "authorDevice": "reviewer"
              }
            ]
          },
          "expect": {
            "status": 201,
            "bodyShape": {
              "acceptedLength": 1,
              "acceptedEnvelopeIds": [
                "env-lc-1"
              ],
              "acceptedServerSeqAtLeast": 1
            }
          }
        },
        {
          "action": "openSocket",
          "in": "room",
          "from": "owner",
          "as": "sock-owner"
        },
        {
          "action": "sendFrame",
          "socket": "sock-owner",
          "frame": {
            "type": "subscribe",
            "after": 0
          }
        },
        {
          "action": "expectFrame",
          "socket": "sock-owner",
          "frame": {
            "type": "hello",
            "serverSeq": 1
          }
        },
        {
          "action": "expectFrame",
          "socket": "sock-owner",
          "ignore": [
            "ping"
          ],
          "frame": {
            "type": "envelope",
            "envelopeId": "env-lc-1",
            "serverSeqAtLeast": 1
          }
        },
        {
          "action": "postAcks",
          "in": "room",
          "from": "owner",
          "params": {
            "envelopeIds": [
              "env-lc-1"
            ],
            "ownerSigFrom": "owner"
          },
          "expect": {
            "status": 204
          }
        },
        {
          "action": "expectStorageState",
          "in": "room",
          "expect": {
            "missingEnvIdx": [
              "env-lc-1"
            ],
            "hasOwnerAckMarker": [
              "env-lc-1"
            ]
          }
        },
        {
          "action": "closeSocket",
          "socket": "sock-owner"
        },
        {
          "action": "deleteRoom",
          "in": "room",
          "params": {
            "ownerSigFrom": "owner"
          },
          "expect": {
            "status": 204
          }
        }
      ]
    },
